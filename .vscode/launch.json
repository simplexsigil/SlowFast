{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [

        {
      "name": "Run Python Script",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "justMyCode": false
    },
    {
      "name": "Launch Server",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run_net.py",
      "justMyCode": false,
      "args": [
          "--cfg",
          "configs/MaskDP/NTU/NTURGBD_MVITv2_S_16x4_FT_cs_dp5.yaml",
          "--opt",
          "OUTPUT_DIR",
          "experiments/temp",
          "DATA.PATH_PREFIX",
          "/pfs/work8/workspace/ffhk/scratch/kf3609-datasets/datasets/NTU_RGBD/rgb_60",
          //"DATA.PATH_TO_DATA_DIR",
          //"${env:LSDF}/data/activity/HMDB51/splits_slowfast/split1",
          "NUM_GPUS",
          "2",
          "TRAIN.MIXED_PRECISION",
          "False",
          "MODEL.FP16_ALLREDUCE",
          "False",
          "DATA_LOADER.NUM_WORKERS",
          "16",
          "DATA.PATH_CACHE",
          "False",
          "TRAIN.BATCH_SIZE",
          "8",
          "DATA.ONLOAD_RESIZE",
          "False",
          "AUG.ENABLE",
          "True",
          "AUG.RE_PROB",
          "0.1",
          "MIXUP.ENABLE",
          "False",
          "TRAIN.ENABLE",
          "True",
          "TEST.BATCH_SIZE",
          "8",
          "MODEL.RET_FEATS",
          "False",
          "DO_STATS",
          "False",
          "MODEL.NUM_CLASSES",
          "60",
          "SOLVER.OPTIMIZING_METHOD",
          "sgd",
          "TRAIN.CHECKPOINT_EPOCH_RESET",
          "True",
          "TRAIN.AUTO_RESUME", "False",
          "TRAIN.UNFREEZE_PAT", 
          "(?:module.)?norm.weight|(?:module.)?norm.bias|.*head.projection.*"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
          "KMP_AFFINITY": "noverbose",
          "LOCAL_RANK": "0",
      },
      "console": "integratedTerminal"
  },
  {
    "name": "Launch Workstation",
    "type": "python",
    "request": "launch",
    "program": "${workspaceFolder}/tools/run_net.py",
    "justMyCode": false,
    "args": [
      "--cfg",
      "configs/MaskDP/MaskDP/NTU/MaskDP01_FrozenFT_NTURGBD_CS_MViTv2S.yaml",
      "--opt",
      "DATA.PATH_PREFIX",
      "/lsdf/data/activity/NTU_RGBD/rgb_60",
      "NUM_GPUS",
      "1",
      "DATA_LOADER.NUM_WORKERS",
      "0",
      "DATA.PATH_CACHE",
      "False",
      "TRAIN.BATCH_SIZE",
      "4",
      "TRAIN.AUTO_RESUME",
      "True",
      "DATA.MASK_PREFIX",
      "/lsdf/data/activity/NTU_RGBD/ntu_synth/rgb_60_rend_mask",
    ],
    "cwd": "${workspaceFolder}",
    "env": {
        "KMP_AFFINITY": "noverbose",
        "LOCAL_RANK": "0",
    },
    "console": "integratedTerminal"
},
{
  "name": "Test",
  "type": "python",
  "request": "launch",
  "program": "${workspaceFolder}/tools/run_net.py",
  "justMyCode": false,
  "args": [
    "--cfg",
    "configs/MaskDP/tests/Test_real_NTURGBD_CS_MViTv2S.yaml",
    "--opt",
    "DATA.PATH_PREFIX",
    "/lsdf/data/activity/NTU_RGBD/rgb_60",
    "NUM_GPUS",
    "1",
    "MODEL.RET_FEATS",
    "True",
    "TEST.SAVE_RESULTS_PATH",
    "real_test_set.pkl",
    "TEST.BATCH_SIZE",
    "32",
    "DO_STATS",
    "True"
  ],
  "cwd": "${workspaceFolder}",
  "env": {
      "KMP_AFFINITY": "noverbose",
      "LOCAL_RANK": "0",
  },
  "console": "integratedTerminal"
}
    
    ]
}



