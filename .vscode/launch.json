    "version": "0.2.0",
    "configurations": [

        {
      "name": "Run Python Script",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/mnist_dp_test.py",
      "justMyCode": false
    },
    {
      "name": "Launch Slowfast",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/tools/run_net.py",
      "justMyCode": false,
      "args": [
          "--cfg",
          "configs/MaskDP/NTU/NTURGBD_MVITv2_S_16x4_FT_cs_dp5.yaml",
          "--opt",
          "OUTPUT_DIR",
          "experiments/temp",
          "DATA.PATH_PREFIX",
          "/pfs/work8/workspace/ffhk/scratch/kf3609-datasets/datasets/NTU_RGBD/rgb_60",
          //"DATA.PATH_TO_DATA_DIR",
          //"${env:LSDF}/data/activity/HMDB51/splits_slowfast/split1",
          "NUM_GPUS",
          "1",
          "TRAIN.MIXED_PRECISION",
          "False",
          "MODEL.FP16_ALLREDUCE",
          "False",
          "DATA_LOADER.NUM_WORKERS",
          "16",
          "DATA.PATH_CACHE",
          "False",
          "TRAIN.BATCH_SIZE",
          "32",
          "DATA.ONLOAD_RESIZE",
          "False",
          "AUG.ENABLE",
          "True",
          "AUG.RE_PROB",
          "0.1",
          "MIXUP.ENABLE",
          "False",
          "TRAIN.ENABLE",
          "True",
          "TEST.BATCH_SIZE",
          "8",
          "MODEL.RET_FEATS",
          "False",
          "DO_STATS",
          "False",
          "MODEL.NUM_CLASSES",
          "60",
          "SOLVER.OPTIMIZING_METHOD",
          "sgd",
          "TRAIN.UNFREEZE_PAT",
          ".*head.projection.*",
          "TRAIN.CHECKPOINT_EPOCH_RESET",
          "True"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
          "KMP_AFFINITY": "noverbose",
          "LOCAL_RANK": "0",
      },
      "console": "integratedTerminal"
  }
    
    ]
}